# Copy to .env and fill in. EXPO_PUBLIC_ variables are inlined into the app bundle.

# Google Gemini — https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.8-flash)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# Optional: thinking level, low | medium | high (default: low — much faster)
# EXPO_PUBLIC_GEMINI_THINKING=low

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
EXPO_PUBLIC_ELEVENLABS_API_KEY=
# Optional: override the TTS model (default: eleven_v3 — eleven_v3_conversational is faster but cuts audio off)
# EXPO_PUBLIC_ELEVENLABS_MODEL=eleven_v3
# Optional: voice IDs for the Female / Male options (defaults: "Armenian Woman" / "George")
# EXPO_PUBLIC_ELEVENLABS_VOICE_FEMALE=Uzip068RriboSuMJCIne
# EXPO_PUBLIC_ELEVENLABS_VOICE_MALE=JBFqnCBsd6RMkjVDRZzb
